<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardBackgroundColor="#FF2A2A2A"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:minHeight="72dp">

        <!-- Room icon -->
        <ImageView
            android:id="@+id/roomIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_dialog_dialer"
            android:tint="#FF00DFDF"
            android:layout_marginEnd="12dp"
            tools:ignore="ContentDescription" />

        <!-- Room info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/roomName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end"
                tools:text="Smash Bros Room" />

            <TextView
                android:id="@+id/roomGame"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FF9C9897"
                android:textSize="13sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_marginTop="2dp"
                tools:text="Super Smash Bros. | Host: Player1" />

            <TextView
                android:id="@+id/roomStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FF747273"
                android:textSize="12sp"
                android:layout_marginTop="2dp"
                tools:text="Waiting | 1/2 players" />
        </LinearLayout>

        <!-- Player count badge -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginStart="8dp">

            <TextView
                android:id="@+id/playerCount"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:textColor="#FF1A1A1A"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/bg_badge"
                tools:text="1/2" />

            <ImageView
                android:id="@+id/passwordIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="4dp"
                android:src="@android:drawable/ic_lock_lock"
                android:tint="#FF747273"
                android:visibility="gone"
                tools:ignore="ContentDescription" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
