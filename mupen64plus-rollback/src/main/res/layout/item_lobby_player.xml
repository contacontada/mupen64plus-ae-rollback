<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:padding="12dp"
    android:background="#FF1E1E1E"
    android:layout_marginBottom="2dp">

    <!-- Player avatar/icon -->
    <ImageView
        android:id="@+id/playerIcon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@android:drawable/ic_menu_myplaces"
        android:tint="#FF00DFDF"
        android:layout_marginEnd="12dp"
        tools:ignore="ContentDescription" />

    <!-- Player info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/playerSlot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FF00DFDF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="#FF2A2A2A"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                tools:text="P1" />

            <TextView
                android:id="@+id/playerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:layout_marginStart="8dp"
                tools:text="Player Name" />

            <TextView
                android:id="@+id/playerSelf"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="(You)"
                android:textColor="#FF00DFDF"
                android:textSize="12sp"
                android:layout_marginStart="6dp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/playerEndpoint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FF747273"
            android:textSize="12sp"
            android:layout_marginTop="2dp"
            tools:text="192.168.1.100:4445" />
    </LinearLayout>

    <!-- Ping -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginStart="8dp">

        <TextView
            android:id="@+id/pingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FF00DFDF"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="45ms" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ping"
            android:textColor="#FF747273"
            android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>
